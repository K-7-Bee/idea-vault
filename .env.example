NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The only email allowed into /vault
ALLOWED_EMAIL=
# Google Drive (Phase 3). Server only; never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_KEY=
# Optional: the Google account allowed to connect Drive (defaults to ALLOWED_EMAIL)
DRIVE_GOOGLE_ACCOUNT=
# Google Picker (visible in the page by design; restrict the key to these sites and the Picker API)
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# Phase 3B switch: "1" sends new attachments to the owner's Google Drive folder (default off)
DRIVE_UPLOADS_ENABLED=
# Phase 5A: the read-only Gemini assistant. Off unless AI_ENABLED=1 AND a key is set (server only).
# Use a key from a billing-enabled (paid tier) Google Cloud project; never commit a real key.
GEMINI_API_KEY=
AI_ENABLED=
# Optional: model (default gemini-3.8-flash), monthly ceiling in USD (default 5), questions per day (default 40)
GEMINI_MODEL=
AI_MONTHLY_USD=
AI_DAILY_REQUESTS=
